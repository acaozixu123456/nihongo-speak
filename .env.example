# Claude API（对话、提示、纠错）
ANTHROPIC_API_KEY=
# Azure Speech（语音识别、发音评估、TTS），免费层 F0 即可
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
# 登录密码（只有你自己用）
APP_PASSWORD=
# 可选：HD 语音用的第二个 Azure Speech 资源（Japan East 不支持 HD，用 southeastasia、S0）
# 不填或调用失败时，自动改用上面免费资源里的普通语音
AZURE_TTS_KEY=
AZURE_TTS_REGION=southeastasia
