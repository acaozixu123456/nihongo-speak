# Claude API（出题、改写新闻、电台、判对错、老师）
ANTHROPIC_API_KEY=
# Azure Speech（英语语音识别、发音评估、备用 TTS），免费层 F0 即可
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
# 可选：HD 语音用的第二个 Azure Speech 资源（选支持 HD 的区域，如 southeastasia、S0）
# 不填或调用失败时，自动改用上面资源里的普通语音
AZURE_TTS_KEY=
AZURE_TTS_REGION=southeastasia
# Gemini：Vertex AI 服务账号 JSON（整段粘贴），或者 AI Studio 的 key
VERTEX_SERVICE_ACCOUNT=
GEMINI_API_KEY=
# 定时任务的密钥（随便一串长字符）
CRON_SECRET=
# Vercel Blob：在 Vercel 里连接一个新的 Blob 存储后自动注入，本地开发时填 token
BLOB_READ_WRITE_TOKEN=
